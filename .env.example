BOT_TOKEN=
ALLOWED_USER_ID=

LOG_LEVEL=INFO

# HTML pages: search, book cards, author pages.
CONTENT_BASE_URL=https://flisland.net
# EPUB/FB2 files are downloaded only from this base.
DOWNLOAD_BASE_URL=https://flibusta.is

# Optional: put temporary downloads on tmpfs to spare the SD card.
# TEMP_DIR=/dev/shm/knigojor

HTTP_TIMEOUT=30
DOWNLOAD_TIMEOUT=180
DOWNLOAD_ATTEMPTS=3

MAX_RETRIES=3
MAX_PARALLEL_REQUESTS=5
MAX_PARALLEL_DOWNLOADS=1

MAX_FILE_SIZE_MB=50
PAGE_SIZE=5
